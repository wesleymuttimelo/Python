# Chave gratuita da OMDb — veja o README para criar/ativar
OMDB_API_KEY=

# Opcionais (valores padrão já existem no código/settings)
OMDB_BASE_URL=https://www.omdbapi.com/
OMDB_TIMEOUT_SECONDS=10

# Cardápio Pix (app separado, porta 8001). Troque o token antes de publicar.
CARDAPIO_ADMIN_TOKEN=
CARDAPIO_PUBLIC_BASE_URL=http://127.0.0.1:8001
CARDAPIO_PIX_KEY=
CARDAPIO_PIX_NAME=
CARDAPIO_DB_PATH=data/cardapio.sqlite
